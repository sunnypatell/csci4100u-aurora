	</column>
	<column name="created_at" not-null="true" default-value="now()">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<constraint name="resources_kind_check" type="ck-constr" table="public.resources">
			<expression> <![CDATA[(kind = ANY (ARRAY['hotline'::text, 'hospital'::text, 'clinic'::text, 'counseling'::text, 'organization'::text]))]]> </expression>
