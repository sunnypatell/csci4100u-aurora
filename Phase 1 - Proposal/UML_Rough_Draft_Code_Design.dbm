</sequence>

<table name="resource_locations" layers="0" collapse-mode="2" max-obj-count="9" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="660" y="1780"/>
	<column name="id" not-null="true" sequence="public.resource_locations_id_seq">
		<type name="bigint" length="0"/>
	</column>
	<column name="resource_id" not-null="true">
		<type name="bigint" length="0"/>
	</column>
	<column name="address_line1">
		<type name="text" length="0"/>
	</column>
	<column name="city">
		<type name="text" length="0"/>
	</column>
	<column name="province">
		<type name="text" length="0"/>
	</column>
	<column name="postal_code">
		<type name="text" length="0"/>
	</column>
	<column name="latitude">
		<type name="numeric" length="9" precision="6"/>
	</column>
	<column name="longitude">
		<type name="numeric" length="9" precision="6"/>
	</column>
	<constraint name="resource_locations_latitude_check" type="ck-constr" table="public.resource_locations">
			<expression> <![CDATA[((latitude >= ('-90'::integer)::numeric) AND (latitude <= (90)::numeric))]]> </expression>
	</constraint>
	<constraint name="resource_locations_longitude_check" type="ck-constr" table="public.resource_locations">
			<expression> <![CDATA[((longitude >= ('-180'::integer)::numeric) AND (longitude <= (180)::numeric))]]> </expression>
	</constraint>
	<constraint name="resource_locations_pkey" type="pk-constr" table="public.resource_locations">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

<index name="idx_resource_locations_geo" table="public.resource_locations"
	 concurrent="false" unique="false" fast-update="false" buffering="false" nulls-not-distinct="false"
	 index-type="btree" factor="90">
		<idxelement use-sorting="false">
			<column name="latitude"/>
		</idxelement>
		<idxelement use-sorting="false">
			<column name="longitude"/>
		</idxelement>
</index>

