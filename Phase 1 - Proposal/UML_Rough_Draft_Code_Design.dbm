<table name="mood_checkins" layers="0" alias="User mood entries. Multiple per day allowed." collapse-mode="2" max-obj-count="13" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<comment> <![CDATA[User mood entries. Multiple per day allowed.]]> </comment>
	<position x="-100" y="840"/>
	<column name="id" not-null="true" sequence="public.mood_checkins_id_seq">
		<type name="bigint" length="0"/>
	</column>
	<column name="user_id" not-null="true">
		<type name="bigint" length="0"/>
	</column>
	<column name="mood_score" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="mood_label">
		<type name="text" length="0"/>
	</column>
	<column name="note">
		<type name="text" length="0"/>
	</column>
	<column name="latitude">
		<type name="numeric" length="9" precision="6"/>
	</column>
	<column name="longitude">
		<type name="numeric" length="9" precision="6"/>
	</column>
	<column name="geocode_text">
		<type name="text" length="0"/>
	</column>
	<column name="created_at" not-null="true" default-value="now()">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="updated_at" not-null="true" default-value="now()">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<column name="deleted_at">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<constraint name="mood_checkins_mood_score_check" type="ck-constr" table="public.mood_checkins">
			<expression> <![CDATA[((mood_score >= 1) AND (mood_score <= 5))]]> </expression>
	</constraint>
	<constraint name="mood_checkins_latitude_check" type="ck-constr" table="public.mood_checkins">
			<expression> <![CDATA[((latitude >= ('-90'::integer)::numeric) AND (latitude <= (90)::numeric))]]> </expression>
	</constraint>
	<constraint name="mood_checkins_longitude_check" type="ck-constr" table="public.mood_checkins">
			<expression> <![CDATA[((longitude >= ('-180'::integer)::numeric) AND (longitude <= (180)::numeric))]]> </expression>
	</constraint>
	<constraint name="mood_checkins_pkey" type="pk-constr" table="public.mood_checkins">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
</table>

